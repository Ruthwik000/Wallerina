# =============================================================================
# Wallerina backend configuration
#
# Only ALCHEMY_API_KEY is required. Everything else is optional: with no AWS
# the service still runs, with persistence, queueing and
# model-written explanations degraded rather than broken.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Wallet balances, token prices and price history.
# https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# --- Service -----------------------------------------------------------------
# APP_ENV=production disables auto-reload and refuses to start with wildcard
# CORS or static AWS keys.
# APP_ENV=development
# Frontend origins allowed to call the API, comma-separated.
# CORS_ORIGINS=http://localhost:3000
# Required (as X-Admin-Token) for POST /api/refresh/run. Blank: open in
# development, disabled in production.
# ADMIN_TOKEN=
# Per-client limit on model, simulation and wallet-scan endpoints. 0 = off.
# RATE_LIMIT_PER_MINUTE=30
# true behind a load balancer, so the limit applies per caller, not per balancer.
# TRUST_PROXY_HEADERS=false
# true behind CloudFront whose origin accepts only CloudFront: per-viewer limits.
# BEHIND_CLOUDFRONT=false

# --- Wallet sign-in and execution --------------------------------------------
# Signs sign-in sessions. Required wherever more than one API process runs;
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
# SESSION_TTL_HOURS=24
# Accepted sign-in message domains, comma-separated. Blank: CORS_ORIGINS hosts.
# SIWE_DOMAINS=
# 0x Swap API key (https://dashboard.0x.org). Without it trades can be prepared
# and reviewed, but not quoted or executed.
ZEROEX_API_KEY=
# SWAP_SLIPPAGE_BPS=100

# --- Agents / model (NVIDIA NIM) ---------------------------------------------
# All model calls go to NVIDIA's hosted NIM API (OpenAI-compatible).
# Key from https://build.nvidia.com (starts with nvapi-).
NVIDIA_API_KEY=
# Any NIM chat model with tool calling.
# CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Without a key: preset goals still work and explanations fall back to a
# deterministic write-up built from the engine's own drivers. Only free-text
# goal parsing and model-written prose are lost.

# =============================================================================
# AWS  (see docs/aws/aws_usage.md)
#
# Leave AWS_ENABLED=false to run without any AWS account.
# Running on ECS/Fargate: set AWS_ENABLED=true and AWS_REGION, then leave the
# key/secret blank so boto3 picks up the task role. Only set static keys for
# local development against real AWS.
# =============================================================================
AWS_ENABLED=false
# NOTE: setting this true points a LOCAL dev server at real AWS. Two defaults
# then apply that are easy to miss:
#   REFRESH_ENABLED=true          re-caches to S3 and snapshots wallets into
#                                 Aurora every 5 minutes, which is what keeps
#                                 an Aurora Serverless cluster from pausing
#   SIMULATION_WORKER_ENABLED=true  this process consumes the SQS queue itself
# Set REFRESH_ENABLED=false locally unless you are deliberately testing them.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# For LocalStack / MinIO, e.g. http://localhost:4566
AWS_ENDPOINT_URL=

# --- Secrets Manager ---------------------------------------------------------
# Name or ARN of one secret holding a JSON object of the keys above. Values
# found there are layered UNDER the environment, so a local export still wins.
# Example secret body:
#   {"ALCHEMY_API_KEY": "...", "NVIDIA_API_KEY": "..."}
AWS_SECRET_ID=

# --- RDS / Aurora PostgreSQL (IAM authentication) -----------------------------
# Portfolio snapshots, risk metrics, simulations and the recommendation log.
# There is no password: a fresh IAM token is generated by boto3 for every new
# connection. Credentials come from the default AWS chain (~/.aws locally, the
# ECS task role in production) and need rds-db:connect for RDS_USER. AWS_REGION
# above must be the cluster's region. Leave RDS_HOST blank to run without a DB.
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=wallerina
RDS_USER=wallerina_app
# DATABASE_POOL_SIZE=5

# --- S3 ----------------------------------------------------------------------
# Historical market data and portfolio snapshots.
S3_BUCKET=

# --- SQS ---------------------------------------------------------------------
# Queue for heavy Monte Carlo runs.
# https://sqs.eu-north-1.amazonaws.com/<account-id>/wallerina-simulations
SQS_QUEUE_URL=
# Queue a run when simulations x horizon_days exceeds this.
# SIMULATION_QUEUE_THRESHOLD=5000000
# Queued runs need RDS: the worker writes each result into its job row. The API
# process consumes the queue itself unless this is false; turn it off where a
# Lambda on the queue or a separate worker service does that instead.
# SIMULATION_WORKER_ENABLED=true

# --- CloudWatch --------------------------------------------------------------
# Custom metrics. Logs reach CloudWatch via stdout under ECS and Lambda.
CLOUDWATCH_ENABLED=false

# =============================================================================
# Tuning (optional)
# =============================================================================
# HISTORY_DAYS=180
# DEFAULT_SIMULATIONS=10000
# PORTFOLIO_MIN_USD_VALUE=1.0
# PORTFOLIO_MAX_PAGES=20

# --- Background refresh (every 5 minutes) ------------------------------------
# Re-caches core price history and Polymarket data in S3 and snapshots tracked
# wallets. Set false if the same jobs run on an EventBridge schedule instead.
# REFRESH_ENABLED=true
# REFRESH_INTERVAL_MINUTES=5
# REFRESH_SNAPSHOTS=true
